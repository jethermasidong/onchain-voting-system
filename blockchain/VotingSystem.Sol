pragma solidity ^0.8.20;

contract VotingSystem {
    
    address public admin;

    mapping(uint256 => bool) public candidateExists;

    mapping(uint256 => uint256) public voteCounts;

    mapping(bytes32 => bool) public hasVotedHash;

    event VoteCast(uint256 indexed candidateId, uint256 timestamp); 
    event CandidateRegistered(uint256 indexed candidateId);

    modifier onlyAdmin() {
        require(msg.sender == admin, "Caller is not the admin");
        _;
    }

    constructor() {
        admin = msg.sender;
    }


    function addCandidate(uint256 _id) external onlyAdmin {
        require(!candidateExists[_id], "Candidate already registered");
        candidateExists[_id] = true;
        emit CandidateRegistered(_id);
    }

    function castVote(bytes32 _voterHash, uint256[] calldata _candidateIds) external {
        require(!hasVotedHash[_voterHash], "Credentials already used to cast a ballot");
        require(_candidateIds.length > 0, "Must select atleast one candidate");

        hasVotedHash[_voterHash] = true;

        for (uint256 i = 0; i < _candidateIds.length; i++) {
            uint256 candidateId = _candidateIds[i];
            require(candidateExists[candidateId], "Invalid candidate ID");

            voteCounts[candidateId]++;

            emit VoteCast(candidateId, block.timestamp);
        }
    }

    function getCandidateVotes(uint256 _candidateId) external view returns (uint256) {
        require(candidateExists[_candidateId], "Candidate does not exist");
        return voteCounts[_candidateId];
    }
}